{
  "name": "job-tracker-api",
  "version": "1.0.0",
  "description": "Job application tracker API: Express 5, MySQL, MongoDB, JWT with refresh rotation, keyset pagination",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/db/migrate.js && node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "check": "node -e \"require('node:fs').readdirSync('src',{recursive:true}).filter(f=>f.endsWith('.js')).forEach(f=>{require('node:child_process').execFileSync(process.execPath,['--check','src/'+f],{stdio:'inherit'});console.log('ok  src/'+f)})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yashashviarora/job-tracker-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Yashashviarora/job-tracker-api/issues"
  },
  "homepage": "https://github.com/Yashashviarora/job-tracker-api#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.4",
    "mysql2": "^3.24.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
