# ---- server ----
NODE_ENV=development
PORT=3000

# ---- mysql (docker container: jobtracker-mysql, host port 3306) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# ---- jwt ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d


# ---- mongodb (docker container: jobtracker-mongo, host port 27017) ----
MONGO_URI=mongodb://127.0.0.1:27017/job_tracker

